{
  "name": "libreoffice-webbrowser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "description": "LibreOffice Writer ported to TypeScript, running natively in the browser.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "upstream:fetch": "bash tools/upstream/fetch.sh",
    "upstream:gen": "node tools/upstream/gen-ui.ts && node tools/upstream/gen-shapes.ts",
    "upstream:check": "node tools/upstream/check-ports.ts",
    "upstream:report": "node tools/upstream/coverage.ts",
    "upstream:migrate": "node tools/upstream/migrate.ts"
  },
  "dependencies": {
    "hunspell-asm": "^4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
