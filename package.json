{
  "name": "officetab",
  "version": "26.0.0-beta",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "description": "OfficeTab: a browser-native port of LibreOffice. A suite of apps (Writer for now; Calc and Impress to follow).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:writer": "vite --open /writer/",
    "build": "npm run typecheck && node tools/languagetool/data.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:writer": "playwright test --project writer",
    "upstream:fetch": "bash tools/upstream/fetch.sh",
    "upstream:gen": "node tools/upstream/gen-ui.ts && node tools/upstream/gen-shapes.ts && node tools/upstream/gen-tableautoformats.ts && node tools/upstream/gen-autocorr.ts && node tools/upstream/gen-templates.ts",
    "upstream:check": "node tools/upstream/check-ports.ts",
    "upstream:report": "node tools/upstream/coverage.ts",
    "upstream:migrate": "node tools/upstream/migrate.ts",
    "languagetool:data": "node tools/languagetool/data.ts",
    "version:bump": "node tools/build/bump-version.ts"
  },
  "dependencies": {
    "hunspell-asm": "^4.0.2",
    "markdown-it": "^14.3.3",
    "oniguruma-to-es": "^4.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@iconify-json/fluent": "^1.2.61",
    "@iconify-json/keyline-icons": "^1.2.21",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/material-symbols": "^1.2.98",
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
